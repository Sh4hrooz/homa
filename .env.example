NODE_ENV=production
HOMA_ACCESS_PASSWORD=replace-with-a-long-random-password-at-least-16-chars
HOMA_OWNER_NAME=مدیر پروژه

# Primary team member: OpenAI-compatible API. Keep keys ONLY on the server.
OPENAI_API_KEY=server-side-secret
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional team member: Anthropic
ANTHROPIC_API_KEY=server-side-secret
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional team member: Google Gemini
GEMINI_API_KEY=server-side-secret
GEMINI_MODEL=gemini-2.5-flash

# Optional fourth OpenAI-compatible member
HOMA_API_BASE_2=https://your-openai-compatible-endpoint/v1
HOMA_API_KEY_2=server-side-secret
HOMA_MODEL_2=your-model

HOMA_DB_PATH=/app/data/homa.sqlite
